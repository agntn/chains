{
  "name": "@agntn/chains",
  "version": "0.5.0",
  "description": "Canonical blockchain classes with registry, aliases, and address validation",
  "homepage": "https://chains.agntn.dev",
  "bugs": "https://github.com/agntn/chains/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/chains.git"
  },
  "bin": {
    "chains": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/pi",
    "extensions/omp"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "docs": "pnpm --filter docs dev",
    "fmt": "pnpm build && vp lint --fix && vp fmt",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "test": "pnpm build && vp test run",
    "test:watch": "vp test watch",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@agntn/encodings": "catalog:deps",
    "@agntn/hashes": "catalog:deps",
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "changelogen": "catalog:dev",
    "obuild": "catalog:dev",
    "rolldown": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "ai": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "omp": {
    "extensions": [
      "./extensions/omp/chains.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/chains.ts"
    ],
    "image": "https://chains.agntn.dev/image.png"
  }
}
